# Server
PORT=3000
NODE_ENV=development

# Jellyfin
JELLYFIN_BASE_URL=http://localhost:8096
# API key from Jellyfin > Dashboard > API Keys; used by the catalogue sync
JELLYFIN_API_KEY=

# Auth
SESSION_SECRET=replace-with-a-long-random-secret

# Cookies (true behind HTTPS, also when a proxy terminates TLS)
COOKIE_SECURE=false

# Reverse proxy: which proxies may set X-Forwarded-For/-Proto.
# Default: loopback and private networks. "false" disables, a number trusts that many hops.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# TMDB
TMDB_API_KEY=

# Image cache (optional)
# Directory for resized poster/backdrop renditions; relative paths are resolved from the repo root
# IMAGE_CACHE_DIR=cache/images
# Upper limit of that directory in MB; least recently used renditions are deleted beyond it
# IMAGE_CACHE_MAX_MB=2048

# Web Push (optional): without them VANTA makes its own key pair on the first
# start and keeps it in db/requests.db. The subject is a contact for push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Updates (optional): in production every start pulls, builds and checks a
# newer origin/main first (also npm run update). "false" switches that off.
# AUTO_UPDATE=true
# Where db/ is copied before an update (the newest 5 stay)
# UPDATE_BACKUP_DIR=backups
