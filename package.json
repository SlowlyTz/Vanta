{
  "name": "jellyfin-client",
  "version": "1.0.0",
  "description": "Apple TV style Jellyfin Web Client",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "refresh": "node scripts/refresh-catalog.js",
    "player:build": "vite build --config src/player/vite.config.js",
    "player:watch": "vite build --watch --config src/player/vite.config.js",
    "intro:build": "vite build --config src/intro/vite.config.js",
    "countdown:build": "vite build --config src/countdown/vite.config.js",
    "build": "npm run player:build && npm run intro:build && npm run countdown:build && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "hls.js": "^1.6.16",
    "morgan": "^1.10.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "three": "^0.186.0",
    "vidstack": "^0.6.15",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
